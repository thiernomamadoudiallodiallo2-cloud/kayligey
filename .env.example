# À définir dans Netlify > Site settings > Environment variables (jamais dans le code)
DATABASE_URL=postgresql://user:motdepasse@host/kayligey?sslmode=require
APP_ORIGIN=https://votre-site.netlify.app
# Uniquement pour scripts/create-admin.js (exécution locale, à ne pas conserver)
ADMIN_TEL=
ADMIN_PASSWORD=
# Envoi SMS/e-mail (étape ultérieure) : si absent, les codes ne sont PAS envoyés
SMS_PROVIDER_KEY=

# Paiement Wave (étape 3) — sans ces 3 variables, le paiement en ligne est désactivé
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SIGNING_SECRET=
COMMISSION_BPS=0

# Notifications (étape 4) — chaque canal reste inactif sans ses variables
RESEND_API_KEY=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Dossier médical (étape 5) — secret des liens de téléchargement (32+ caractères aléatoires)
DOC_LINK_SECRET=

# Vidéo (Twilio Video) — console Twilio > Video > Tools > API Keys
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Sauvegardes chiffrées (16+ caractères, à garder dans un gestionnaire de mots de passe)
BACKUP_KEY=

# Uniquement pour « npm run smoke » (après déploiement) et « npm run seed-test » (base de TEST seulement)
SITE_URL=
KAY_ALLOW_SEED=
